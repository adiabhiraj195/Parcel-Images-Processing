# ==============================================================================
# Parcel Intelligence - Docker & EC2 Environment Variables Template
# ==============================================================================
# Copy this file to .env before running: docker compose up -d
#
# cp .env.example .env
# ==============================================================================

# --- Backend Settings ---
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Worker concurrency (1 for standard CPU/t3/c7g, 2-4 if high-spec instance)
WORKER_CONCURRENCY=1

# --- AWS S3 Configuration ---
# Required for original scan storage and presigned direct browser uploads
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-private-parcel-intelligence-bucket

# AWS Credentials (OPTIONAL if your EC2 instance has an attached IAM Role!)
# If using EC2 IAM Role, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# Presigned URL Lifetimes
PRESIGNED_PUT_EXPIRY_SECONDS=900
PRESIGNED_GET_EXPIRY_SECONDS=300

# Pipeline Settings
OCR_ENGINE=paddleocr
PADDLE_OCR_VERSION=PP-OCRv5
SAVE_DEBUG_BUNDLE=true
MOCK_INFERENCE=false

# --- Frontend Settings ---
# Leave blank when using the bundled Nginx reverse proxy on port 80.
# If accessing backend directly without Nginx, set e.g.: http://<EC2_PUBLIC_IP>:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MOCK_DATA=false
